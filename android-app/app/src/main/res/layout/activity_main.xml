<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#121212" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🌌 Aether Studio (Native)" android:textColor="#4af626" android:textSize="22sp" android:textStyle="bold" android:layout_gravity="center" android:layout_marginBottom="16dp"/>
    <EditText android:id="@+id/codeInput" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="#1e1e1e" android:textColor="#9cdcfe" android:gravity="top" android:padding="12dp" android:fontFamily="monospace" android:textSize="16sp"/>
    <Button android:id="@+id/runButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="▶ SPUSTIT KÓD" android:backgroundTint="#00bcd4" android:textColor="#121212" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
    <TextView android:id="@+id/outputView" android:layout_width="match_parent" android:layout_height="150dp"
        android:background="#0d0d0d" android:textColor="#4af626" android:padding="12dp" android:fontFamily="monospace"/>
</LinearLayout>
